# Outgoing mail is disabled for the suite: the tests that need it enabled swap
# `MailConfigService` instead. Blanking every variable is what makes that
# independent of whatever SMTP relay a developer points their own `.env` at.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# Same reasoning: left unset, the registration policy is derived from whether
# the instance already has an account, which is exactly what the tests around
# the bootstrap window describe. A developer whose own `.env` pins
# `ALLOW_REGISTRATION=open` would otherwise see those tests fail.
ALLOW_REGISTRATION=
