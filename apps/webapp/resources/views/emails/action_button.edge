<p style="margin: 24px 0;">
  <a href="{{ url }}" style="display: inline-block; padding: 12px 20px; background-color: #18181b; color: #ffffff; border-radius: 8px; font-weight: 600; text-decoration: none;">{{ label }}</a>
</p>

<p style="margin: 0 0 24px; font-size: 13px; color: #71717a; word-break: break-all;">
  If the button does not work, copy this link into your browser: {{ url }}
</p>
