@component('emails/layout', { title: 'Reset your password' })
  <p style="margin: 0 0 16px;">Hi {{ name }},</p>

  <p style="margin: 0 0 16px;">
    Someone asked to reset the password of your {{ brandName }} account.
  </p>

  @!component('emails/action_button', { url: resetUrl, label: 'Choose a new password' })

  <p style="margin: 0;">
    This link stops working in {{ expiresInHours }} hours and can only be used
    once. If you did not ask for it, ignore this email — your password stays as
    it is.
  </p>
@end
