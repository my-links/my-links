# App
TZ=UTC
PORT=3333
HOST=localhost
LOG_LEVEL=debug
APP_KEY=
NODE_ENV=development

# App url
APP_URL=http://localhost:3333

# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=root
DB_PASSWORD=root
DB_DATABASE=app

# Session (leave unset for "database"; .env.test overrides to "memory")
SESSION_DRIVER=database

# Google sign-in (optional)
# Leave both empty to run without Google sign-in. Setting only one of the two
# is rejected at boot.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Rate limiting on /api/v1/* (leave unset for "database"; .env.test overrides to "memory")
LIMITER_STORE=database
