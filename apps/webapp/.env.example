# App
TZ=UTC
PORT=3333
HOST=localhost
LOG_LEVEL=debug
APP_KEY=
NODE_ENV=development

# App url
APP_URL=http://localhost:3333

# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=root
DB_PASSWORD=root
DB_DATABASE=app

# Session (leave unset for "database"; .env.test overrides to "memory")
SESSION_DRIVER=database

# Google sign-in (optional)
# Leave both empty to run without Google sign-in. Setting only one of the two
# is rejected at boot.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Rate limiting on /api/v1/* (leave unset for "database"; .env.test overrides to "memory")
LIMITER_STORE=database

# Outgoing mail (optional)
# Leave everything empty to run without email: verification and password reset
# links are then unavailable, and account recovery goes through the ace
# commands instead. Setting any one of these commits to a complete
# configuration — a partial one is rejected at boot.
# SMTP_PORT defaults to 587, and TLS is implied on 465.
# In development, `docker compose -f dev.compose.yml up` starts mailpit on
# 1025 with its inbox on http://localhost:8025.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
