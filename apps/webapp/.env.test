# Japa's session test client (loginAs, withSession) always simulates
# sessions against the `memory` store — the app's own session middleware
# must resolve to that same store during tests, or session-guarded routes
# see every request as unauthenticated. See config/session.ts.
SESSION_DRIVER=memory

# `database` would work too (functional tests already run inside a rolled-back
# transaction), but `memory` keeps the rate-limits table out of tests entirely
# — one less thing a global-transaction test has to reason about.
LIMITER_STORE=memory
