		"node-html-parser": "^9.0.0",
		"pg": "^8.22.0",
		"proxy-addr": "^2.0.7",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"reflect-metadata": "^0.2.2",
		"ua-parser-js": "^2.0.10",
		"zustand": "^5.0.14"
	},
	"devDependencies": {
		"@adonisjs/assembler": "^8.4.0",
