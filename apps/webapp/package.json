		"@lingui/swc-plugin": "^6.5.1",
		"@lingui/vite-plugin": "^6.5.0",
		"@poppinss/ts-exec": "^1.4.4",
		"@release-it/conventional-changelog": "^11.0.1",
		"@tuyau/utils": "^0.0.9",
		"@types/luxon": "^3.7.2",
		"@types/node": "^24.10.0",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@unocss/preset-icons": "^66.7.5",
		"@unocss/preset-web-fonts": "^66.7.5",
