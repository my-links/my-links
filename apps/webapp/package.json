		"#providers/*": "./providers/*.js",
		"#database/*": "./database/*.js",
		"#tests/*": "./tests/*.js",
		"#start/*": "./start/*.js"
	},
	"scripts": {
		"start": "node bin/server.js",
		"build": "node ace build",
		"dev": "node ace serve --hmr",
		"test": "node ace test unit functional",
		"test:browser": "SMTP_HOST=localhost SMTP_PORT=1025 MAIL_FROM_ADDRESS=test@my-links.localhost MAIL_FROM_NAME=MyLinks node ace test browser",
