		"@adonisjs/static": "^2.0.1",
		"@adonisjs/vite": "6.0.0-next.1",
		"@inertiajs/react": "^3.6.1",
		"@lingui/core": "^6.5.0",
		"@lingui/react": "^6.5.0",
		"@minimalstuff/ui": "^2.0.0",
		"@tuyau/client": "^0.2.10",
		"@tuyau/core": "^1.2.2",
