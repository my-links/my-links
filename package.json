{
	"name": "my-links-monorepo",
	"version": "0.0.0",
	"private": true,
	"license": "GPL-3.0-only",
	"type": "module",
	"scripts": {
		"dev:webapp": "pnpm --filter @my-links/webapp dev",
		"dev:extension": "pnpm --filter @my-links/extension dev",
		"build": "pnpm -r run build",
		"build:webapp": "pnpm --filter @my-links/webapp build",
		"build:extension": "pnpm --filter @my-links/extension build",
		"test": "pnpm --filter @my-links/webapp test",
		"typecheck": "pnpm -r run typecheck",
		"lint": "oxlint --type-aware",
		"lint:fix": "oxlint --type-aware --fix --fix-suggestions --fix-dangerously",
		"format": "pnpm run lint:fix; oxfmt --write .",
		"format:check": "oxfmt --check .",
		"check": "pnpm run lint && pnpm run format:check && pnpm run typecheck",
		"docs:dev": "vitepress dev docs",
		"docs:build": "vitepress build docs",
		"docs:preview": "vitepress preview docs",
		"prepare": "husky",
		"release:webapp": "pnpm --filter @my-links/webapp exec release-it",
		"release:extension": "pnpm --filter @my-links/extension exec release-it"
	},
	"devDependencies": {
		"@iconify-json/ant-design": "^1.2.8",
		"@iconify-json/fa6-regular": "^1.2.4",
		"@iconify-json/fa6-solid": "^1.2.4",
		"@iconify-json/ion": "^1.2.7",
		"@iconify-json/logos": "^1.2.12",
		"@iconify-json/mdi": "^1.2.3",
		"@iconify-json/octicon": "^1.2.32",
		"@iconify-json/svg-spinners": "^1.2.4",
		"@iconify-json/tabler": "^1.2.38",
		"@iconify-json/twemoji": "^1.2.5",
		"@minimalstuff/tooling": "^0.6.0",
		"@unocss/preset-icons": "^66.7.5",
		"@unocss/preset-web-fonts": "^66.7.5",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0",
		"oxfmt": "^0.62.0",
		"oxlint": "^1.77.0",
		"oxlint-tsgolint": "^7.0.2001",
		"unocss": "^66.7.5",
		"vitepress": "^1.6.4"
	},
	"lint-staged": {
		"*.{js,ts,jsx,tsx}": [
			"oxlint --fix --fix-suggestions --fix-dangerously",
			"oxfmt --write"
		]
	},
	"volta": {
		"node": "24.14.0"
	},
	"packageManager": "pnpm@11.21.0"
}
