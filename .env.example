# Timezone & environment
TZ=Europe/Paris
NODE_ENV=development
LOG_LEVEL=info
HOST=localhost
PORT=3333

# App
APP_KEY=
ALLOW_REGISTRATION=open
# Optional, at least 32 characters. While the instance has no administrator,
# only a registration carrying this token can become one. Left empty, a random
# token is generated at every boot and its setup link is logged.
ADMIN_SETUP_TOKEN=
APP_URL=http://localhost:3333

# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=root
DB_PASSWORD=root
DB_DATABASE=app

# Google sign-in (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Browser extension (optional)
# Comma-separated Chromium extension ids or Firefox add-on ids trusted to
# connect, on top of the official store builds. For dev or self-built extensions.
EXTENSION_IDS=

# Reverse proxy (optional)
# Comma-separated proxy-addr names (loopback, linklocal, uniquelocal), IPs or
# CIDR ranges trusted to set X-Forwarded-For. Replaces the default private
# ranges when set. Leave empty to keep the default.
TRUSTED_PROXIES=

# Outgoing mail (optional)
# Leave everything empty to run without email: verification and password reset
# links are then unavailable, and account recovery goes through the ace
# commands instead. Setting any one of these commits to a complete
# configuration: a partial one is rejected at boot.
# SMTP_PORT defaults to 587, and TLS is implied on 465.
# In development, `docker compose -f dev.compose.yml up` starts mailpit on
# 1025 with its inbox on http://localhost:8025.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
